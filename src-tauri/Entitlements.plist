<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The bundle is signed with the hardened runtime. Under it, macOS grants a
      process the microphone only when its code signature carries this
      entitlement; the usage description in Info.plist alone is not enough.
      Without it TCC denied Utterform silently: no permission dialog, no entry
      under System Settings, a recording of silence.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
